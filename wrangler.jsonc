{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "shuangxiugou-fullstack",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-09-20",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shuangxiugou-db",
      "database_id": "a0cc7c0b-98bd-43fd-a147-5e704cf38cd2",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "FILES",
      "id": "e6967c6de1f746278250c4fd373e06c5"
    }
  ]
}
